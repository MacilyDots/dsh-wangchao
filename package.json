{
  "name": "dsh-wangchao",
  "version": "0.2.0",
  "type": "module",
  "description": "DeepSeek Harness plugin: cross-session status from an allowlist, live streaming for active sessions, a read-only chief-of-staff advisor, plans and tasks, and a standalone full-screen view. Observe-only by default.",
  "author": "Macily Lei",
  "license": "MIT",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client.js",
    "live-stream.mjs",
    "mini-react.js",
    "standalone.html",
    "plan-tools.mjs",
    "plan-evidence.mjs",
    "task-store.mjs",
    "multi-task.mjs",
    "governance.mjs",
    "handoff.mjs",
    "exec-policy.mjs",
    "exec-lifecycle.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "cross-session",
    "observability",
    "dashboard",
    "live-stream",
    "task-scheduler",
    "standalone-window"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MacilyDots/dsh-wangchao.git"
  },
  "homepage": "https://github.com/MacilyDots/dsh-wangchao#readme",
  "bugs": {
    "url": "https://github.com/MacilyDots/dsh-wangchao/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compat": {
      "dsh": "0.2.2-rc.3",
      "note": "Built and tested against DeepSeek Harness 0.2.2-rc.3. Other versions are untested."
    }
  }
}
