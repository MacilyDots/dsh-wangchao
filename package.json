{
  "name": "dsh-wangchao",
  "version": "0.3.1",
  "type": "module",
  "description": "DeepSeek Harness 跨会话总控插件（御书房）：白名单冷热采集、可追溯摘要与修订、只读首辅及受控任务调度（Fail-Closed）。",
  "author": "Macily Lei",
  "license": "MIT",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client.js",
    "live-stream.mjs",
    "mini-react.js",
    "standalone.html",
    "plan-tools.mjs",
    "plan-evidence.mjs",
    "task-store.mjs",
    "multi-task.mjs",
    "governance.mjs",
    "handoff.mjs",
    "exec-policy.mjs",
    "exec-lifecycle.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "exec-budget.mjs",
    "exec-gate-wiring.mjs",
    "writer-epoch-fencing.mjs",
    "orphan-tmp.mjs"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "cross-session",
    "observability",
    "dashboard",
    "live-stream",
    "task-scheduler",
    "standalone-window"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MacilyDots/dsh-wangchao.git"
  },
  "homepage": "https://github.com/MacilyDots/dsh-wangchao#readme",
  "bugs": {
    "url": "https://github.com/MacilyDots/dsh-wangchao/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compat": {
      "dsh": "0.2.2-rc.3",
      "note": "Built and tested against DeepSeek Harness 0.2.2-rc.3. Other versions are untested."
    }
  }
}
